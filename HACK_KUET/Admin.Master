<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="HACK_KUET.Admin" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Admin Panel</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background: #f4f6f9;
        }

        .admin-header {
            background: #0f172a;
            color: white;
            padding: 15px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .container {
            padding: 20px;
        }

        .logout {
            color: white;
            text-decoration: none;
            background: red;
            padding: 5px 10px;
            border-radius: 5px;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
            font-family: Arial;
        }

/* SIDEBAR */
.sidebar {
    width: 220px;
    background: #0f172a;
    color: white;
    padding: 20px;
}

.sidebar h2 {
    margin-bottom: 20px;
    font-size: 20px;
}

.sidebar a {
    display: block;
    color: white;
    text-decoration: none;
    padding: 10px;
    margin: 5px 0;
    border-radius: 6px;
}

.sidebar a:hover {
    background: #1e293b;
}

/* LOGOUT */
.sidebar .logout {
    margin-top: 20px;
    background: #ef4444;
}

/* MAIN AREA */
.main-content {
    flex: 1;
    background: #f4f6f9;
}

/* TOP BAR */
.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;

    width: 100%;
    padding: 15px 20px;

    background: white;
    border-bottom: 1px solid #ddd;

    box-sizing: border-box;
}

.topbar h3 {
    margin: 0;
}

.topbar .logout {
    margin-left: auto;
    background: #ef4444;
    color: white;
    padding: 8px 14px;
    border-radius: 6px;
    text-decoration: none;
}

/* PAGE CONTENT */
.content {
    padding: 20px;
}
.dashboard-cards {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

.card {
    flex: 1;
    min-width: 200px;
    background: white;
    padding: 25px;
    border-radius: 10px;
    text-align: center;
    box-shadow: 0 5px 15px rgba(0,0,0,0.08);
}

.card h1 {
    margin: 0;
    font-size: 40px;
    color: #0f172a;
}

.card p {
    margin: 10px 0 0;
    color: gray;
}

.event-card {
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    margin-bottom: 20px;
}

input,
textarea,
select,
.modern-input,
.input {
    width: 100%;
    box-sizing: border-box;
    display: block;
}

.row {
    display: flex;
    gap: 10px;
    align-items: center;
}

.grid {
    width: 100%;
    border-collapse: collapse;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    table-layout: fixed;
}

.grid th {
    background: #0f172a;
    color: white;
    padding: 12px;
    text-align: left;
}

.grid td {
    padding: 12px;
    border-bottom: 1px solid #eee;
    word-break: break-word;
}

.grid tr:hover {
    background: #f8fafc;
}

.modern-event {
    background: linear-gradient(135deg, #ffffff, #f1f5f9);
    border-radius: 16px;
    padding: 30px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.08);
    transition: 0.3s;
}

.modern-event:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.12);
}

.event-title {
    margin-bottom: 20px;
    color: #0f172a;
}

.form-grid {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.modern-input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    transition: 0.25s;
    outline: none;
    background: #fff;
}

.modern-input:focus {
    border-color: #0f172a;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
}

.two-cols {
    display: flex;
    gap: 15px;
    width: 100%;
}

.two-cols .field {
    flex: 1;
    min-width: 0;
}

.btn-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 20px;
}

.modern-btn {
    padding: 12px 30px;
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color: white;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: 0.3s;
    font-weight: bold;
}

.modern-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.3);
}

.modern-member {
    background: linear-gradient(135deg, #ffffff, #f8fafc);
    border-radius: 16px;
    padding: 30px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.08);
    transition: 0.3s;
    margin-bottom: 20px;
}

.modern-member:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.12);
}

/* Reuse existing styles but ensure consistency */
.form-grid {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.field {
    width: 100%;
}

.field label {
    font-size: 13px;
    color: #475569;
    margin-bottom: 5px;
    display: block;
}

.checkbox-field {
    display: flex;
    align-items: center;
    padding: 10px 5px;
    gap: 8px;
    font-size: 14px;
    color: #334155;
}

.checkbox-field input {
    width: auto !important;
    margin: 0;
    transform: scale(1.1);
}

.modern-input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    outline: none;
    font-size: 14px;
    transition: 0.2s;
}

.modern-input:focus {
    border-color: #0f172a;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
}

.btn-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 20px;
}

.modern-btn {
    padding: 12px 30px;
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color: white;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: 0.3s;
    font-weight: bold;
}

.modern-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.3);
}

.btn-edit {
    background: #0ea5e9;
    color: white;
    border: none;
    padding: 5px 10px;
    border-radius: 6px;
    margin-right: 5px;
    cursor: pointer;
}

.btn-delete {
    background: #ef4444;
    color: white;
    border: none;
    padding: 5px 10px;
    border-radius: 6px;
    cursor: pointer;
}
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>
<form id="form1" runat="server">

<div class="admin-wrapper">

    <!-- SIDEBAR -->
    <div class="sidebar">

        <h2>HACK KUET</h2>
        <a href="AdminHome.aspx">🏠 Home</a>
        <a href="AdminMessages.aspx">📩 Messages</a>
        <a href="AdminEvents.aspx">📅 Events</a>
        <a href="AdminMembers.aspx">👥 Members</a>
        <hr />
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">

        <div class="topbar">
        <h3>Admin Panel</h3>

        <a href="AdminLogout.aspx" class="logout">
            🚪 Logout
        </a>
        </div>

        <div class="content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

    </div>

</div>

</form>
</body>
</html>